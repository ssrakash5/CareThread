# Copy to backend/.env and fill in.
# Local Postgres (docker) default:
# CARETHREAD_DATABASE_URL=postgresql+psycopg2://carethread:carethread@localhost:5434/carethread
# CockroachDB Cloud (uses the cockroachdb+psycopg2 dialect):
CARETHREAD_DATABASE_URL=cockroachdb+psycopg2://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# --- AWS / AI (uses ambient AWS credentials: env vars, ~/.aws/credentials, or role) ---
# bedrock = Claude on Amazon Bedrock + Titan embeddings; local = regex/hash stand-ins (no network)
CARETHREAD_AI_PROVIDER=bedrock
CARETHREAD_AWS_REGION=us-east-1
# Optional: explicit keys. Leave empty to use ~/.aws/credentials or env vars.
CARETHREAD_AWS_ACCESS_KEY_ID=
CARETHREAD_AWS_SECRET_ACCESS_KEY=
CARETHREAD_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
CARETHREAD_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
CARETHREAD_EMBEDDING_DIM=256
# Leave empty to store raw artifacts on local disk instead of S3
CARETHREAD_S3_BUCKET=
